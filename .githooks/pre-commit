#!/bin/sh

echo "Running Laravel Pint on staged PHP files..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.php$')

if [ -z "$STAGED_FILES" ]; then
    echo "No staged PHP files found. Skipping Pint."
    exit 0
fi

./vendor/bin/pint $STAGED_FILES

if [ $? -ne 0 ]; then
    echo "Pint failed. Commit cancelled."
    exit 1
fi

# Re-stage only the files that were already staged
echo "$STAGED_FILES" | xargs git add

echo "Pint completed successfully."
