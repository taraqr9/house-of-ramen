# Laravel runtime/cache/storage
/bootstrap/cache/*

# ...except the .gitignore placeholder itself (Laravel's own convention
# for keeping an otherwise-empty required directory present after a
# fresh clone, without tracking the generated cache files inside it).
!/bootstrap/cache/.gitignore

/storage/*

# ...except Laravel's own empty-runtime-directory placeholders below
# (storage/app/private/.gitignore etc.), which need storage/app/
# un-ignored first so their own deeper exceptions can take effect.
# Restaurant content images (storage/app/public/restaurant/) are
# deliberately NOT tracked directly here - they're regenerated from the
# real source images committed under database/seed-data/restaurant/ via
# RestaurantSeeder, the same "offline reproducible" pattern, just with
# the seed-data directory as the source of truth instead of storage/.
!/storage/app/
/storage/app/*

# ...and except Laravel's own empty-runtime-directory placeholders
# (each is just a committed `.gitignore` containing `*` + `!.gitignore`,
# the framework's standard convention for keeping a required-but-empty
# directory present after a fresh clone without tracking its actual
# runtime output). A previous, broken attempt at this exact exception
# (a bare, non-negated list of these same paths above the blanket rule)
# did nothing - a pattern with no `!` prefix is just another ignore
# rule, not an un-ignore - so these directories were never actually
# tracked, which is exactly what left a fresh checkout with no
# storage/framework/{views,sessions,cache/data} or storage/logs and
# broke every Blade/Inertia response ("Please provide a valid cache
# path") until each was manually created.
!/storage/app/private/
/storage/app/private/*
!/storage/app/private/.gitignore
!/storage/debugbar/
/storage/debugbar/*
!/storage/debugbar/.gitignore
!/storage/framework/
/storage/framework/*
!/storage/framework/cache/
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
!/storage/framework/cache/data/
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
!/storage/framework/testing/
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
!/storage/framework/views/
/storage/framework/views/*
!/storage/framework/views/.gitignore
!/storage/logs/
/storage/logs/*
!/storage/logs/.gitignore
