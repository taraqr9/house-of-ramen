APP_NAME="House of Ramen"
# The values below (local/true) are for local development only. A real
# deploy MUST set APP_ENV=production and APP_DEBUG=false - leaving debug
# mode on in production leaks stack traces, config values, and .env
# contents to any visitor who triggers an error. See the "Production
# Deployment" section of README.md for the full production checklist.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# If serving locally via `php artisan serve` (composer dev), this MUST include
# the port (e.g. http://localhost:8000) - storage/image URLs are generated from
# this value, and a missing port silently breaks every image on the public site.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Bangladesh-only app - see config/app.php for why this isn't UTC.
APP_TIMEZONE=Asia/Dhaka

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Read by database/seeders/AdminSeeder.php when first bootstrapping the
# admin account (`php artisan db:seed --class=AdminSeeder`, or the first
# `php artisan db:seed`) - sets the seeded admin's email address. The
# seeded admin is always username=admin, password=password.
# ADMIN_SEED_EMAIL=admin@yourdomain.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# A real MySQL database, created before running `php artisan migrate` -
# these local-dev credentials (root/root) will not exist on a real
# server. See README.md "Requirements" - no other DB driver is tested.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=house_of_ramen
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# `database` (default) is sufficient - the only queued work is the
# password-reset mailable, drained by a self-terminating `queue:work
# --stop-when-empty` on the same schedule as the cron entry (see README
# "Production Deployment"). Redis is NOT required for this app.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log = mail is written to the log file only, never actually delivered -
# fine for local dev, but a production deploy needs a real mailer (e.g.
# smtp) or the one queued mailable (password-reset emails) will silently
# never reach anyone.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@houseoframen.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public site SEO defaults (config/seo.php) - all optional, fall back to
# APP_URL/APP_NAME if unset. Set SEO_BASE_URL only if the canonical
# public domain ever needs to differ from APP_URL.
# SEO_SITE_NAME="House of Ramen"
# SEO_ORGANIZATION_NAME="House of Ramen"
# SEO_BASE_URL="${APP_URL}"
# SEO_DEFAULT_OG_IMAGE=images/logo-light.png

# Sends an automatic Telegram message to the restaurant's own Telegram
# whenever a customer submits a reservation request on the homepage
# (App\Services\Telegram\TelegramNotifier). Free, no signup, no bot setup -
# uses CallMeBot (callmebot.com), an independent free service (not
# affiliated with Telegram) meant for exactly this kind of low-volume
# personal notification. Leave unset in local dev - the notification is
# skipped silently and the reservation still saves and still shows up in
# the admin panel's bell notifications either way.
#
# One-time setup (do this FROM the restaurant's own Telegram account):
#   1. Search for the contact @CallMeBot_txtbot in Telegram and open a
#      chat with it.
#   2. Send it this exact message: I allow callmebot to send me messages
#   3. You'll get a reply confirming you're registered.
#   4. Fill in your Telegram username below, including the "@"
#      (e.g. @yourusername) - it must be the same account you messaged
#      from in step 2, and you must have a public username set in
#      Telegram (Settings > Username).
TELEGRAM_USERNAME=

# Google Analytics 4 (GA4) Measurement ID for the public House of Ramen site
# only (resources/js/app.js / utils/analytics.js) - never the admin panel,
# which doesn't load Vite/Inertia at all. Leave unset in local dev: with
# no ID, or outside a production build, analytics silently no-ops. See
# README.md "Analytics (GA4)".
VITE_GA_MEASUREMENT_ID=

# Server-side Google Analytics Data API - powers the "Analytics" section on
# the admin /admin dashboard (App\Services\Analytics\*), completely separate
# from VITE_GA_MEASUREMENT_ID above (that's the public site's client-side
# tracking ID; this is a read-only server-to-server API connection to the
# same GA4 property). Leave unset in local dev - the Analytics dashboard
# section shows "Analytics data temporarily unavailable." without breaking
# the rest of the admin panel. Full setup instructions (enabling the API,
# creating the service account, granting it GA4 property access, and which
# custom dimensions must be registered for the dashboard's breakdowns to
# return data) are in README.md "Analytics dashboard (GA4 Data API)".
#
# GA4_PROPERTY_ID is the numeric Property ID (GA4 Admin -> Property Settings),
# NOT the "G-XXXXXXXXXX" Measurement ID used above.
# GA4_PROPERTY_ID=123456789
#
# Absolute path to a service account JSON key file granted Viewer access to
# the GA4 property - NEVER commit this file. storage/app/private/ is
# already git-ignored by default, so it's a safe local location.
# GA4_CREDENTIALS_PATH=/absolute/path/to/storage/app/private/ga4-service-account.json
#
# How long (seconds) one GA4 report is cached before the dashboard re-queries
# the API.
# GA4_CACHE_TTL=300

# Inertia server-side rendering (resources/js/ssr.js) - optional. If the
# SSR process (`php artisan inertia:start-ssr`, after `npm run
# build:ssr`) isn't running, Inertia falls back to client-side rendering
# automatically - the site keeps working either way, only the raw HTML
# per-page <title>/meta/JSON-LD (used by crawlers/scrapers that don't run
# JS) is affected. See config/inertia.php and CLAUDE.md.
INERTIA_SSR_ENABLED=true
# INERTIA_SSR_URL=http://127.0.0.1:13714
